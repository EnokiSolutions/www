---
import Base from '../layouts/Base.astro';
---

<Base
	title="Enoki Solutions"
	description="Enoki Solutions Inc. builds software and offers software and data consulting. Our first product is Cliff's HK Mahjong, a free Hong Kong mahjong app for Android."
>
	<section class="hero">
		<h1>We build small,<br />sharp software.</h1>
		<p class="hero-lede">
			Enoki Solutions is a small software studio. We offer consulting
			services in software and data, and we build our own products —
			starting with a Hong Kong mahjong app worth opening every night.
		</p>
	</section>

	<section class="services">
		<p class="kicker">Consulting</p>
		<h2>Software and data, done properly</h2>
		<p class="services-lede">
			We work with teams on software design, implementation, and data
			problems — from a focused engagement to an ongoing partnership.
		</p>
		<a class="nav-link services-link" href="mailto:enquire@enoki.ca"
			>Get in touch: enquire@enoki.ca</a
		>
	</section>

	<section class="upcoming">
		<p class="kicker">Our first product</p>
		<h2><a class="title-link" href="/hkmj/">Cliff's HK Mahjong</a></h2>
		<p class="upcoming-lede">
			A fully functional Hong Kong mahjong game, free, with no ads.
			Play offline, on your own, or with friends in person.
		</p>
		<a class="nav-link product-link" href="/hkmj/">Learn more and join the beta</a>
	</section>

	<section class="upcoming">
		<p class="kicker">Coming soon</p>
		<h2><a class="title-link" href="/isaludo/">Isaludo</a></h2>
		<p class="upcoming-lede">
			A collection of ten solo card games, each playable with nothing
			more than a standard deck.
		</p>
		<a class="nav-link product-link" href="/isaludo/">More about Isaludo</a>
	</section>

	<section class="upcoming">
		<p class="kicker">Free download</p>
		<h2><a class="title-link" href="/midi-lowest-note/">MIDI Pass Lowest Note Only</a></h2>
		<p class="upcoming-lede">
			A Max for Live MIDI effect that passes only the lowest held note
			and can strip keyswitches.
		</p>
		<a class="nav-link product-link" href="/midi-lowest-note/">Details and download</a>
	</section>
</Base>
