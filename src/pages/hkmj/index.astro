---
import Base from '../../layouts/Base.astro';

const tester_group = 'https://groups.google.com/g/chkmj-app-testers';
const play_store_testing = 'https://play.google.com/apps/testing/ca.enoki.hkmj';
---

<Base
	title="Cliff's HK Mahjong — Enoki Solutions"
	description="Cliff's HK Mahjong is a free Hong Kong mahjong app for Android with no ads, offline play, and local multiplayer."
>
	<a slot="nav" class="nav-link" href={tester_group}>Join the beta</a>

			<section class="product">
				<div class="product-intro">
					<p class="kicker">Android app</p>
					<h2>Cliff's HK Mahjong</h2>
					<p class="product-lede">
						A fully functional Hong Kong mahjong game, free, with no ads.
						Play offline, on your own, or with friends in person.
					</p>
				</div>

				<ul class="features">
					<li>
						<h3>Free, with no ads</h3>
						<p>
							The full game, with no purchases, subscriptions, or ads —
							nothing to unlock and nothing interrupting play.
						</p>
					</li>
					<li>
						<h3>Play entirely offline</h3>
						<p>
							No account and no internet connection required. Play a full
							game against the AI anywhere, anytime.
						</p>
					</li>
					<li>
						<h3>Local multiplayer with friends</h3>
						<p>
							Sit up to four players down at the same table using Google's
							Nearby Connections API — no server, no Wi-Fi network, no
							account, just devices in the same room.
						</p>
					</li>
					<li>
						<h3>Hong Kong scoring rules</h3>
						<p>
							Faan values and chip conversion follow Hong Kong mahjong
							scoring, with table-specific rules like the minimum faan set
							once and remembered for future games.
						</p>
					</li>
				</ul>

				<div class="screens">
					<img
						src="/images/hkmj/screenshot-start.png"
						alt="Cliff's HK Mahjong start screen"
						class="screen"
						width="900"
						height="506"
						loading="lazy"
					/>
					<img
						src="/images/hkmj/screenshot-game.png"
						alt="A game of Cliff's HK Mahjong in progress"
						class="screen"
						width="900"
						height="506"
						loading="lazy"
					/>
					<img
						src="/images/hkmj/screenshot-nearby.png"
						alt="Setting up a nearby multiplayer game in Cliff's HK Mahjong"
						class="screen"
						width="900"
						height="506"
						loading="lazy"
					/>
				</div>

				<div class="cta">
					<p class="cta-status">Closed beta, open door.</p>
					<div class="cta-buttons">
						<a class="button button-primary" href={tester_group}
							>Join the tester group</a
						>
						<a class="button button-secondary" href={play_store_testing}
							>Already in the group? Opt in on Play Store</a
						>
					</div>
				</div>

				<a class="nav-link product-link" href="/hkmj/privacy/">Privacy policy</a>
			</section>
</Base>
